# Copiar como .env.restauracion (ese archivo NO se sube a GitHub) y completar.
#
# DESTINO_*: el proyecto de PRUEBA de Supabase (o el nuevo, en un desastre),
# nunca produccion. Los dos salen de Supabase > Project Settings > API.
DESTINO_URL=https://xxxxxxxx.supabase.co
DESTINO_SERVICE_KEY=

# La clave con la que se cifran las copias: la misma del secreto BACKUP_CLAVE
# de GitHub, guardada fuera de GitHub cuando se configuro el backup.
BACKUP_CLAVE=
